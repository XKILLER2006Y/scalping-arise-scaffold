# Copy to backend/.env — never commit real keys
SCALPING_ARISE_TWELVE_DATA_API_KEY=
SCA_API_KEY=
# OANDA v20 (practice-first). Paper mode works WITHOUT these (demo chain).
# Add a practice token to unlock real XAU/USD SPOT history + paper execution path.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice
# DANGER: live orders require ALL of LIVE_TRADING=true + OANDA_ENV=live +
# real token/account + confirm_live=true on the call. Default stays paper.
LIVE_TRADING=false
